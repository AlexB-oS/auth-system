# Copia este archivo a .env (o exporta estas variables) para producción.
# En desarrollo, si no se definen, la app genera claves efímeras en instance/dev_secrets.json
# (SOLO para demo local; NUNCA usar claves autogeneradas en producción).

# Clave para firmar las cookies de sesión de Flask (32+ bytes aleatorios).
APP_SECRET_KEY=cambia-esto-por-un-valor-aleatorio-largo

# Clave maestra Fernet (urlsafe base64, 32 bytes) para CIFRAR los secretos TOTP en reposo.
# Genera una con:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# IMPORTANTE: si esta clave cambia o se pierde, los secretos TOTP ya guardados no podrán descifrarse.
TOTP_MASTER_KEY=

# Cookie segura: poner en 1 cuando se sirva sobre HTTPS (en local HTTP se deja en 0).
SESSION_COOKIE_SECURE=0

# Parámetros de bloqueo por fuerza bruta (opcionales; hay defaults seguros en config.py).
# MAX_PASSWORD_ATTEMPTS=5
# MAX_TOTP_ATTEMPTS=5
# LOCKOUT_BASE_SECONDS=30
# LOCKOUT_CAP_SECONDS=900

# Parámetros TOTP (opcionales).
# TOTP_DIGITS=6
# TOTP_PERIOD=30
# TOTP_WINDOW=1
# TOTP_ISSUER=IIC2531-AuthDemo
